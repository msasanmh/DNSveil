[Unit]
Description=DNSveil Secure DNS Client
Documentation=https://github.com/seyed-ali-002/DNSveil-Linux
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/dnsveil-server
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=mixed

# Logging to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dnsveil

# Hardening
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/dnsveil /var/lib/dnsveil /var/log/dnsveil /etc/resolv.conf
PrivateTmp=true

# Environment
Environment=DNSVEIL_CONFIG=/etc/dnsveil
Environment=DNSVEIL_DATA=/var/lib/dnsveil
Environment=DNSVEIL_LOG=/var/log/dnsveil

[Install]
WantedBy=multi-user.target
