<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DNSveil.Cli</RootNamespace>
    <AssemblyName>dnsveil</AssemblyName>
    <Description>DNSveil command-line interface (cross-platform)</Description>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DNSveil.Platform\DNSveil.Platform.csproj" />
    <ProjectReference Include="..\DNSveil.Platform.Linux\DNSveil.Platform.Linux.csproj" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>

</Project>
